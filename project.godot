; Arquivo de configuração do projeto Godot.
; Abra a pasta no Godot 4.7+ (Importar > project.godot) e aperte F5 para jogar.

config_version=5

[application]

config/name="Castelo de Bolo"
config/description="Resgate a princesa do castelo inimigo. Alimente a sua com bolo para que fique pesada demais para ser roubada."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/autoload/config.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="unidades"
3d_physics/layer_3="itens"
3d_physics/layer_4="projeteis"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048

[editor]

; Mantém os .tres como texto no jogo exportado. A conversão para binário
; perdia a lista visible_meshes das classes (personagens ficavam invisíveis).
export/convert_text_resources_to_binary=false
